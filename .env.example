# --- Discord (required) ---
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_GUILD_ID=1492550028504338563

# --- Database (required) ---
DATABASE_URL=postgres://user:password@host:5432/database
# Set to false only for a local Postgres without TLS.
DATABASE_SSL=

# --- Web dashboard ---
PORT=3000
NODE_ENV=production
# Password admins type on the dashboard login page.
ADMIN_DASHBOARD_TOKEN=
# Public base URL of this service, used for the dashboard link button.
DASHBOARD_URL=

# --- AI screenshot verification (all optional, tried in this order) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Fortnite API (optional; the public API works without a key) ---
FORTNITE_API_KEY=

# --- Discord (required) ---
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_GUILD_ID=1091387805550260224

# --- Database (required) ---
DATABASE_URL=postgres://user:password@host:5432/database
# Set to false only for a local Postgres without TLS.
DATABASE_SSL=

# --- Hosting ---
# Render assigns this automatically; only needed for local runs. The server also
# answers "OK" on this port at "/" so UptimeRobot has something to ping.
PORT=3000
NODE_ENV=production
